# Copy to .env. Generate your own random secrets. These are placeholders only.
COMPOSE_PROJECT_NAME=spicyadmin
WEB_PORT=8086
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters
DJANGO_ALLOWED_HOSTS=admin.spicy.is
DJANGO_CSRF_TRUSTED_ORIGINS=https://admin.spicy.is

POSTGRES_DB=spicy_admin
POSTGRES_USER=spicy_admin
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
# Compose fixes HOST/PORT to the private postgres service; optional outside Compose.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_ADMIN_ROLE_ID=
DISCORD_OVERLORD_ROLE_ID=
DISCORD_PATRON_ROLE_ID=
DISCORD_REDIRECT_URI=https://admin.spicy.is/auth/callback/
DISCORD_ROLE_CACHE_SECONDS=45

# Optional until you are ready to connect the read-only CoreProtect source.
# On Linux use the optional host-gateway Compose file OR a verified Docker host bridge IP.
COREPROTECT_DB_HOST=host.docker.internal
COREPROTECT_DB_PORT=3306
COREPROTECT_DB_NAME=
COREPROTECT_DB_USER=
COREPROTECT_DB_PASSWORD=
COREPROTECT_TABLE_PREFIX=co_
COREPROTECT_TIMEOUT_SECONDS=3

# Optional exact Discord user IDs. Grants staff access, never Admin/audit access.
DISCORD_ACCESS_OVERRIDE_USER_IDS=
# Rolling audit history in days. Daily pruning deletes only records older than this age.
AUDIT_LOG_RETENTION_DAYS=365
# Exact socket-peer IPs only, after verifying host Nginx overwrites X-Forwarded-For.
# Empty records REMOTE_ADDR without trusting forwarded headers.
# This deployment uses 172.26.0.1 (verified host/Docker bridge peer); verify your own path.
# Example only: AUDIT_TRUSTED_PROXY_IPS=172.26.0.1
AUDIT_TRUSTED_PROXY_IPS=
