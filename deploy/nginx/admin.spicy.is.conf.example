# MANUAL EXAMPLE ONLY. Review on the host; do not install before TLS is ready.
# Replace both certificate paths below with the actual Certbot-managed paths.
server {
    listen 80;
    server_name admin.spicy.is;
    return 301 https://admin.spicy.is$request_uri;
}

server {
    listen 443 ssl http2;
    server_name admin.spicy.is;

    ssl_certificate /REPLACE/WITH/ACTUAL/fullchain.pem;
    ssl_certificate_key /REPLACE/WITH/ACTUAL/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    client_max_body_size 1m;

    # This proxy is trusted only because the upstream is bound to host loopback.
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 5s;
    proxy_read_timeout 65s;
    proxy_send_timeout 65s;

    location = /auth/callback/ {
        # OAuth codes/state arrive in the query string. Suppress callback request logs.
        access_log off;
        error_log /dev/null;
        proxy_pass http://127.0.0.1:8086;
    }

    location / {
        proxy_pass http://127.0.0.1:8086;
    }
}

